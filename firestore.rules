rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /appointments/{appointmentId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /appointmentAvailability/{date} {
      allow read: if true;
      allow write: if false;
    }

    match /clinicSettings/{settingId} {
      allow read: if settingId == "weeklySchedule";
      allow write: if false;
    }

    match /appointmentSlots/{slotId} {
      allow read, write: if false;
    }

    match /carts/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["items", "updatedAt"])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
